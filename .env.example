# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres. The webhook/staff test runner refuses any database whose name is not
# exactly "legwork_test".
DATABASE_URL=postgresql://user:password@localhost:5432/legwork

# Frontend origin allowed by CORS.
WEB_URL=http://localhost:3000

# "stripe" or "dummy".
PAYMENT_PROVIDER=stripe

# Required when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 64 hex characters. Used for field encryption.
FIELD_ENCRYPTION_KEY=

# Staff auth. JWT_SECRET is required, at least 32 characters, and is never
# logged. Tokens are HS256 with iss=legwork-api and aud=legwork-staff.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Customer auth. Required, at least 32 characters, and must differ from
# JWT_SECRET. Tokens are HS256 with iss=legwork-api and aud=legwork-customer.
CUSTOMER_JWT_SECRET=change-me-to-a-different-random-string-of-at-least-32-chars

# Seeded by `npm run db:seed:staff`. Password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Seeding a database literally named "legwork" requires this to be "true".
ALLOW_SEED_ON_LEGWORK=false

# Late payment review grace window in seconds (0..3600, default 300).
PAYMENT_REVIEW_GRACE_SECONDS=300

# Optional. Defaults to ./private-uploads.
UPLOAD_DIR=./private-uploads

# Rate limit storage: redis (default) or memory.
RATE_LIMIT_STORE=redis
